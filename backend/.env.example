# Server
PORT=3000
CORS_ORIGIN=*

# Proxmox API token (Datacenter > Permissions > API Tokens).
# Give it just enough privilege: PVEAuditor for metrics, plus
# Sys.PowerMgmt on / for the shutdown call.
# Reached via the proxmox.nerdslab.net reverse proxy (real cert) instead of
# the LAN IP directly.
PROXMOX_HOST=proxmox.nerdslab.net
PROXMOX_PORT=443
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=root@pam!panel
PROXMOX_TOKEN_SECRET=replace-me
# The reverse proxy presents a trusted cert, so verify it normally.
PROXMOX_ALLOW_SELF_SIGNED=false

# Wake-on-LAN
WOL_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST_ADDRESS=192.168.0.255
WOL_PORT=9
